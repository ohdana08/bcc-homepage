{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cleanup-pending",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/saju-admin",
      "destination": "/api/claude101-suite?fn=saju-admin"
    },
    {
      "source": "/api/project-instruction",
      "destination": "/api/claude101-suite?fn=project-instruction"
    },
    {
      "source": "/api/document-mate",
      "destination": "/api/claude101-suite?fn=document-mate"
    },
    {
      "source": "/api/course-access",
      "destination": "/api/claude101-suite?fn=course-access"
    },
    {
      "source": "/api/claude101-public-sample",
      "destination": "/api/claude101-suite?fn=public-sample"
    },
    {
      "source": "/api/groble-checkout",
      "destination": "/api/claude101-suite?fn=groble-checkout"
    },
    {
      "source": "/api/groble-claude101-event",
      "destination": "/api/claude101-suite?fn=groble-event"
    }
  ],
  "functions": {
    "api/claude101-suite.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/admin-saju.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://esm.sh 'sha256-qXgub6E2n71OZoUKCZQ/1e1YN+49gbhI+cPp8PT3iVw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src 'self' about:; connect-src 'self' https://jhjxrkypnigcohgnzhvq.supabase.co; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/tools/document-mate/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/tools/project-instruction/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin-project-instructions.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://esm.sh; style-src 'self'; img-src 'self' data:; connect-src 'self' https://jhjxrkypnigcohgnzhvq.supabase.co; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
