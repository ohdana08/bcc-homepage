{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cleanup-pending",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/document-mate", "destination": "/api/claude101-suite?fn=document-mate" },
    { "source": "/api/course-access", "destination": "/api/claude101-suite?fn=course-access" },
    { "source": "/api/claude101-public-sample", "destination": "/api/claude101-suite?fn=public-sample" },
    { "source": "/api/groble-checkout", "destination": "/api/claude101-suite?fn=groble-checkout" },
    { "source": "/api/groble-claude101-event", "destination": "/api/claude101-suite?fn=groble-event" }
  ],
  "functions": {
    "api/claude101-suite.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/tools/document-mate/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'" }
      ]
    }
  ]
}
