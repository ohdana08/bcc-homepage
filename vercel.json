{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cleanup-pending",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/course-access", "destination": "/api/claude101-suite?fn=course-access" },
    { "source": "/api/groble-checkout", "destination": "/api/claude101-suite?fn=groble-checkout" },
    { "source": "/api/groble-claude101-event", "destination": "/api/claude101-suite?fn=groble-event" }
  ]
}
